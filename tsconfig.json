{
  "include": [
    "src/"
  ],
  "exclude": [
    "*.*",
    "pkg/"
  ],
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es6",
    "outFile": "krohnkite.js",
    "noEmitOnError": true,
    "removeComments": true,
    "lib": [
      "es6"
    ],
    "alwaysStrict": true,
    "strict": true
  }
}
