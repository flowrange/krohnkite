{
  "name": "krohnkite-flowrange",
  "version": "0.9.9.2-flowrange.5",
  "description": "Krohnkite with focus-local splits and a dedicated Zen desktop for Plasma",
  "main": "krohnkite.js",
  "directories": {
    "test": "test"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "scripts": {
    "tsc": "tsc",
    "test": "npm run tsc -- --noEmitOnError && node --test test/*.test.cjs",
    "build": "tsc --noEmitOnError",
    "package": "npm run build && python3 tools/package.py",
    "test:kwin": "npm run package && python3 test/kwin.py"
  },
  "author": "Eon S. Jeon <esjeon@hyunmu.am>",
  "license": "MIT",
  "homepage": "https://github.com/flowrange/krohnkite#readme",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowrange/krohnkite.git"
  },
  "bugs": {
    "url": "https://github.com/flowrange/krohnkite/issues"
  }
}
